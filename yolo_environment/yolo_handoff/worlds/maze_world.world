          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>
    <model name='walking_person_forward_pause_forward_clone_2'>
      <pose>-9.00261 6.96294 1.03176 1.54281 -0.035844 0.341735</pose>
    </model>
    <model name='walking_person_forward_pause_forward_clone_2_clone'>
      <pose>4.10873 -2.29841 1.03176 1.54281 -0.035844 0.341735</pose>
    </model>
    <model name='walking_person_forward_pause_forward_clone'>
      <pose>4.1588 -5.09469 1.03176 1.54281 -0.035844 0.341735</pose>
    </model>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-6.53002 -6.1332 28.4934 0 1.36764 1.43219</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <!-- Static Surveillance Camera -->
    <model name="fixed_camera">
      <static>true</static> <!-- This keeps the camera fixed in place -->
      <!-- Position: x y z roll pitch yaw -->
      <pose>-17.0 3.5 1.5 0.1 0.2 -0.750002</pose> 
      <link name="camera_link">
        <sensor name="camera_sensor" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.047</horizontal_fov> <!-- 60 degrees -->
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100.0</far>
            </clip>
          </camera>
          <!-- THIS PLUGIN IS THE MAGIC: It publishes to ROS 2 -->
          <plugin name="surveillance_camera_plugin" filename="libgazebo_ros_camera.so">
            <camera_name>surveillance_camera</camera_name>
            <image_topic_name>/surveillance_camera/image_raw</image_topic_name>
            <camera_info_topic_name>/surveillance_camera/camera_info</camera_info_topic_name>
            <frame_name>camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
